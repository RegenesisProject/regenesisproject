{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/keynote", "destination": "/keynotes", "permanent": true },
    { "source": "/abouts", "destination": "/about", "permanent": true },
    { "source": "/sciences", "destination": "/science", "permanent": true },
    { "source": "/mythologies", "destination": "/mythology", "permanent": true },
    { "source": "/quiz", "destination": "/mirror-quiz", "permanent": true },
    { "source": "/quizzes", "destination": "/mirror-quiz", "permanent": true },
    { "source": "/mirror", "destination": "/mirror-quiz", "permanent": true },
    { "source": "/mirrorquiz", "destination": "/mirror-quiz", "permanent": true },
    { "source": "/mirrorquizzes", "destination": "/mirror-quiz", "permanent": true },
    { "source": "/mirror-quizzes", "destination": "/mirror-quiz", "permanent": true },
    { "source": "/speaker-kits", "destination": "/speaker-kit", "permanent": true },
    { "source": "/speakerkit", "destination": "/speaker-kit", "permanent": true },
    { "source": "/speakerkits", "destination": "/speaker-kit", "permanent": true },
    { "source": "/waitlists", "destination": "/waitlist", "permanent": true },
    { "source": "/wait-list", "destination": "/waitlist", "permanent": true },
    { "source": "/trilogy", "destination": "/waitlist", "permanent": true },
    { "source": "/books", "destination": "/waitlist", "permanent": true },
    { "source": "/contacts", "destination": "/contact", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/press", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/keynotes", "destination": "/keynotes/index.html" },
    { "source": "/science", "destination": "/science/index.html" },
    { "source": "/mythology", "destination": "/mythology/index.html" },
    { "source": "/mirror-quiz", "destination": "/mirror-quiz/index.html" },
    { "source": "/speaker-kit", "destination": "/speaker-kit/index.html" },
    { "source": "/waitlist", "destination": "/waitlist/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(about|keynotes|science|mythology|mirror-quiz|speaker-kit|waitlist|contact)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
